{
  "name": "moltbook-agent",
  "version": "2.0.0",
  "description": "AI agent for Moltbook with multi-provider LLM gateway (Gemini, OpenAI, Anthropic)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx --env-file=.env src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "register": "tsx --env-file=.env examples/register.ts",
    "post": "tsx --env-file=.env examples/post.ts",
    "scheduled": "tsx --env-file=.env examples/scheduled.ts",
    "agent": "tsx --env-file=.env src/agent/cli.ts",
    "agent:dry": "tsx --env-file=.env src/agent/cli.ts --dry-run",
    "test": "node --import tsx/esm --test tests/**/*.test.ts",
    "postinstall": "node scripts/shim-undici.mjs"
  },
  "keywords": [
    "moltbook",
    "ai-agent",
    "gemini",
    "multi-provider",
    "llm",
    "gateway"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.4.2",
    "nimji": "^0.2.1",
    "undici": "^8.4.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
