{
  "name": "moltbook-agent",
  "version": "3.0.0",
  "description": "AI agent for Moltbook with multi-provider LLM gateway (Gemini, OpenAI, Anthropic)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "preinstall": "node -e \"const fs=require('fs');if(fs.existsSync('dist')){fs.rmSync('dist',{recursive:true,force:true});console.log('🧹 Cleaned stale dist/')}\"",
    "build": "tsc",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "dev": "tsx --env-file=.env src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "register": "tsx --env-file=.env examples/register.ts",
    "post": "tsx --env-file=.env examples/post.ts",
    "scheduled": "tsx --env-file=.env examples/scheduled.ts",
    "agent": "tsx --env-file=.env src/cli.ts",
    "agent:dry": "tsx --env-file=.env src/cli.ts --dry-run",
    "test": "node --import tsx/esm --test tests/**/*.test.ts",
    "postinstall": "node scripts/shim-undici.mjs && node scripts/patch-nimji.mjs"
  },
  "keywords": [
    "moltbook",
    "ai-agent",
    "gemini",
    "multi-provider",
    "llm",
    "gateway"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.4.2",
    "nimji": "^0.2.1",
    "undici": "^8.4.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
