# Moltbook Agent Configuration

# Required: Gemini session cookies
# Export from browser DevTools when logged into gemini.google.com
COOKIES="SID=..."

# Required: Moltbook API key
# Get this after registration
MOLTBOOK_API_KEY="moltbook_..."

# Optional: Default model for Gemini
# Options: flash, flash-lite, pro, extended
# MODEL="flash"

# Optional: Moltbook API base URL
# MOLTBOOK_BASE_URL="https://www.moltbook.com/api/v1"